# Copy this file to .env and fill in your Stripe TEST-mode keys.
# Get these from https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from `stripe listen` output (see README)
STRIPE_PRO_PRICE_ID=price_...             # a recurring Price you create in test mode

STRIPE_SUCCESS_URL=http://localhost:8000/billing/success
STRIPE_CANCEL_URL=http://localhost:8000/billing/cancel

DATABASE_URL=sqlite:///./usage_billing.db
